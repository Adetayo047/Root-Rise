<section class="w-full py-space-3xl bg-surface-container-lowest" id="programmes">
  <div class="max-w-7xl mx-auto px-margin-page">
    <div class="text-center max-w-3xl mx-auto mb-space-2xl">
      <span class="font-label-caps text-label-caps text-secondary uppercase tracking-widest block mb-space-2xs">Choose Your Pathway</span>
      <h2 class="font-headline-lg text-headline-lg text-primary mb-space-xs">Three Ways to Root &amp; Rise</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant">
        Whichever stage of life you're starting from, there's a Root &amp; Rise track built for you.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-space-lg items-stretch">

      <!-- Track 1: Professional Craft Programme -->
      <div class="bg-surface-container-low rounded-2xl p-space-lg flex flex-col justify-between shadow-sm">
        <div>
          <div class="flex items-center justify-between mb-space-md">
            <div class="w-12 h-12 rounded-lg bg-primary-container flex items-center justify-center text-on-primary">
              <span class="material-symbols-outlined text-[26px] text-secondary-fixed">work_history</span>
            </div>
            <span class="font-label-caps text-label-caps px-space-xs py-space-3xs bg-surface-container-high text-primary rounded uppercase">Accelerated Pathway</span>
          </div>
          <h3 class="font-headline-sm text-headline-sm text-primary mb-space-xs">Professional Craft Programme</h3>
          <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed mb-space-md">
            An accelerated, practical training pathway for graduates, young adults and individuals with prior craft exposure who want to become professionally grounded within a shorter period. Includes intensive technical training, advanced practical projects, industry exposure and mentorship, digital creative skills, business training, portfolio development and enterprise preparation. Candidates are assessed and placed at the level that matches what they already know.
          </p>
        </div>
        <div class="pt-space-sm border-t border-outline-variant/60">
          <p class="font-headline-sm text-headline-sm text-secondary italic leading-snug">
            "We take what you already know and make you professionally grounded."
          </p>
        </div>
      </div>

      <!-- Track 2: Youth Development Pathway -->
      <div class="bg-surface-container-low rounded-2xl p-space-lg flex flex-col justify-between shadow-sm">
        <div>
          <div class="flex items-center justify-between mb-space-md">
            <div class="w-12 h-12 rounded-lg bg-primary-container flex items-center justify-center text-on-primary">
              <span class="material-symbols-outlined text-[26px] text-secondary-fixed">emoji_people</span>
            </div>
            <span class="font-label-caps text-label-caps px-space-xs py-space-3xs bg-surface-container-high text-primary rounded uppercase">For Younger Learners</span>
          </div>
          <h3 class="font-headline-sm text-headline-sm text-primary mb-space-xs">Youth Development Pathway</h3>
          <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed mb-space-md">
            Designed for learners completing or transitioning from junior secondary education who show strong interest in craft, creativity and practical skills but still need continued educational development. Combines academic enrichment, talent discovery, craft exploration, digital literacy, personal development, social skills and entrepreneurship — moving learners from exploration to specialisation through practical projects, mentorship, exhibitions and supervised industry exposure.
          </p>
        </div>
        <div class="pt-space-sm border-t border-outline-variant/60">
          <p class="font-headline-sm text-headline-sm text-secondary italic leading-snug">
            "We help young people build their educational foundation while discovering, developing and eventually specialising in their talents."
          </p>
        </div>
      </div>

      <!-- Track 3: Short / Online Courses -->
      <div class="bg-primary text-on-primary rounded-2xl p-space-lg flex flex-col justify-between shadow-sm">
        <div>
          <div class="flex items-center justify-between mb-space-md">
            <div class="w-12 h-12 rounded-lg bg-primary-container flex items-center justify-center text-secondary-fixed">
              <span class="material-symbols-outlined text-[26px]">bolt</span>
            </div>
            <span class="font-label-caps text-label-caps px-space-xs py-space-3xs bg-secondary-fixed text-on-secondary-fixed rounded uppercase">5–12 Week Courses</span>
          </div>
          <h3 class="font-headline-sm text-headline-sm text-secondary-fixed mb-space-xs">Short / Online Courses</h3>
          <p class="font-body-sm text-body-sm text-primary-fixed-dim leading-relaxed mb-space-md">
            For people who don't want a full qualification — focused, practical skill-building courses you can complete in weeks, online or in-studio.
          </p>
          <div class="flex flex-wrap gap-space-3xs">
            <% ['Beginner Makeup', 'Gele Styling', 'Bead Making', 'Basic Photography', 'Canva & Graphic Design', 'Social Media for Creatives', 'Bag Making', 'Basic Baking', 'Fashion Illustration', 'AI for Creative Entrepreneurs'].forEach(course => { %>
              <span class="px-space-xs py-space-3xs rounded bg-primary-container text-secondary-fixed font-caption text-[11px]"><%= course %></span>
            <% }) %>
          </div>
        </div>
        <div class="pt-space-md">
          <a class="inline-flex items-center gap-space-3xs text-secondary-fixed font-label-md text-label-md hover:underline" href="https://wa.me/2349074026801" rel="noopener noreferrer" target="_blank">
            <span>Ask About Short Courses</span>
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
