<section class="relative w-full overflow-hidden bg-surface-container-lowest pb-space-3xl pt-space-xl">
  <div class="max-w-7xl mx-auto px-margin-page">
    <div class="flex items-center justify-between flex-wrap gap-space-sm mb-space-lg">
      <div class="inline-flex items-center gap-space-xs px-space-sm py-space-2xs bg-primary-container text-on-primary rounded-full shadow-sm">
        <span class="w-2.5 h-2.5 rounded-full bg-secondary-fixed animate-pulse"></span>
        <span class="font-label-caps text-label-caps uppercase tracking-widest text-secondary-fixed"><%= cohort %> Cohort Admissions Open</span>
      </div>
      <div class="flex items-center gap-space-xs font-label-md text-label-md text-secondary">
        <span class="material-symbols-outlined text-[18px]">calendar_month</span>
        <span class="font-title-md">Resumption Date: <%= resumptionDate %></span>
      </div>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-center">
      <div class="lg:col-span-7 flex flex-col gap-space-md">
        <div class="flex flex-col gap-space-2xs">
          <span class="font-headline-sm text-headline-sm text-secondary italic">Root in Craft. Rise in Possibility.</span>
          <h1 class="font-display-hero text-display-hero text-primary tracking-tight">
            Get <span class="text-secondary underline decoration-secondary-fixed-dim decoration-4 underline-offset-8">Rooted</span> in Your Talent &amp; Rise to All Possibilities.
          </h1>
        </div>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl leading-relaxed">
          A prestigious <strong>3½-Year Professional Craft &amp; Creative Development Programme</strong> engineered to endow exceptional young practitioners with technical mastery, business acumen, and commercial agency to build generational enterprises.
        </p>
        <div class="flex flex-wrap items-center gap-space-sm pt-space-xs">
          <a class="inline-flex items-center justify-center gap-space-xs px-space-lg py-space-sm bg-primary-container text-on-primary font-title-md text-title-md rounded-lg shadow-md hover:bg-primary transition-all" href="#admissions-form">
            <span>Start Application</span>
            <span class="text-secondary-fixed font-normal text-body-sm">(<%= registrationFee %>)</span>
            <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
          </a>
          <a class="inline-flex items-center justify-center gap-space-xs px-space-lg py-space-sm bg-surface-container-high text-on-surface font-title-md text-title-md rounded-lg hover:bg-surface-variant transition-colors" href="#craft-pathways">
            <span>Explore Curriculum</span>
            <span class="material-symbols-outlined text-[20px]">menu_book</span>
          </a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-5 gap-space-2xs pt-space-md mt-space-sm bg-surface-container-low rounded-xl p-space-sm">
          <div class="flex flex-col items-center text-center p-space-2xs">
            <span class="material-symbols-outlined text-secondary text-[24px] mb-space-3xs">carpenter</span>
            <span class="font-label-caps text-label-caps uppercase text-primary font-bold">Learn a Craft</span>
          </div>
          <div class="flex flex-col items-center text-center p-space-2xs">
            <span class="material-symbols-outlined text-secondary text-[24px] mb-space-3xs">menu_book</span>
            <span class="font-label-caps text-label-caps uppercase text-primary font-bold">Build Knowledge</span>
          </div>
          <div class="flex flex-col items-center text-center p-space-2xs">
            <span class="material-symbols-outlined text-secondary text-[24px] mb-space-3xs">work_history</span>
            <span class="font-label-caps text-label-caps uppercase text-primary font-bold">Gain Experience</span>
          </div>
          <div class="flex flex-col items-center text-center p-space-2xs">
            <span class="material-symbols-outlined text-secondary text-[24px] mb-space-3xs">monetization_on</span>
            <span class="font-label-caps text-label-caps uppercase text-primary font-bold">Create &amp; Earn</span>
          </div>
          <div class="col-span-2 sm:col-span-1 flex flex-col items-center text-center p-space-2xs">
            <span class="material-symbols-outlined text-secondary text-[24px] mb-space-3xs">rocket_launch</span>
            <span class="font-label-caps text-label-caps uppercase text-primary font-bold">Build Future</span>
          </div>
        </div>
      </div>
      <div class="lg:col-span-5 relative flex justify-center">
        <div class="relative w-full max-w-md bg-surface-container rounded-2xl p-space-xs shadow-xl overflow-hidden">
          <img class="w-full h-[460px] object-cover rounded-xl" alt="Young artisan tailoring fine bespoke fashion fabric on a wooden studio cutting table, representing craftsmanship at Root and Rise Institute." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDBwrxngXITavgsg2Ca-lbkjTF-AM7yHDJKJxEkFRptN9QM6XbKmH-oC73vIRlmYEcAz_po3v6VIKOV6CpDvPGCZ5twL8bWwthSyUwGg30iChAvhc9BUTp-b6Z-b8gzHQxUqjbnTgGC4y1GmPDVTYgPlNUuf0F2Qmp5nvyHKPy5w1RMW7tEtaSXrZAeVHce02x-MBEOsQnF8SwdWPXlwkaBgsDUcz0lWOUSCgE5LklQorYYs3y-PQGrYg" />
          <div class="absolute -bottom-4 right-4 sm:right-8 bg-primary text-on-primary rounded-full w-36 h-36 p-space-2xs flex flex-col items-center justify-center text-center shadow-2xl">
            <span class="font-label-caps text-[10px] tracking-widest uppercase text-secondary-fixed font-bold">Root In Talent</span>
            <span class="font-headline-lg text-headline-sm text-secondary-fixed italic leading-tight">RISE</span>
            <span class="font-caption text-[10px] text-primary-fixed leading-tight px-1">To All Its Possibilities</span>
            <span class="material-symbols-outlined text-[16px] text-secondary-fixed mt-1">eco</span>
          </div>
          <div class="absolute top-4 left-4 bg-surface/95 backdrop-blur-md px-space-sm py-space-2xs rounded-lg shadow-sm flex items-center gap-space-xs">
            <span class="material-symbols-outlined text-secondary text-[20px]">verified</span>
            <div>
              <span class="block font-label-caps text-[10px] uppercase text-on-surface-variant">Accredited Intake</span>
              <span class="font-label-md text-label-md text-primary">Class of <%= cohort %></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
