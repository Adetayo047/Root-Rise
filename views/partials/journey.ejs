<section class="w-full bg-primary-container text-on-primary py-space-3xl relative" id="journey">
  <div class="max-w-7xl mx-auto px-margin-page">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-space-2xl gap-space-md">
      <div>
        <span class="font-label-caps text-label-caps text-secondary-fixed uppercase tracking-widest block mb-space-2xs">The Academy Pathway</span>
        <h2 class="font-headline-lg text-headline-lg text-on-primary">Your Journey at Root &amp; Rise</h2>
      </div>
      <p class="font-body-md text-body-md text-primary-fixed-dim max-w-md">
        A meticulously structured 42-month vocational continuum transforming dedicated learners into independent masters and enterprise creators.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-space-md">
      <% const stages = [
        { num: '01', duration: '18 MONTHS', title: 'LEARN', badge: false,
          desc: 'Train in your chosen craft while developing your academic, creative, digital, business and professional skills.',
          milestones: ['Studio Foundations', 'Mid-Term Assessments', 'Creative Showcases'] },
        { num: '02', duration: '12 MONTHS', title: 'EXPERIENCE', badge: false,
          desc: 'Gain real-world experience through an industry internship with an approved Root & Rise partner.',
          milestones: ['Industry Mentorship', 'Professional Work Ethics', 'Supervised Production'] },
        { num: '03', duration: '12 MONTHS', title: 'CREATE', badge: false,
          desc: 'Work within the Root & Rise Craft Studio to develop ideas, create products, collaborate and experience the realities of creative enterprise.',
          milestones: ['Incubator Production', 'Physical Showrooms', 'Digital Commerce Launch'] },
        { num: '04', duration: 'GRADUATION', title: 'SHOWCASE & RISE', badge: true,
          desc: 'Present your work through our annual showcases, graduate through our convocation and step into the world equipped to work, create or build your own enterprise.',
          milestones: ['Annual Showcase Presentation', 'Formal Convocation', 'Enterprise & Career Readiness'] },
      ]; %>
      <% stages.forEach(stage => { %>
        <div class="bg-primary rounded-xl p-space-lg flex flex-col justify-between shadow-lg relative group hover:bg-surface-tint/20 transition-all">
          <div>
            <div class="flex items-center justify-between mb-space-md">
              <span class="w-12 h-12 rounded-full <%= stage.badge ? 'bg-secondary text-on-secondary' : 'bg-secondary-fixed-dim text-on-secondary-fixed' %> flex items-center justify-center font-headline-sm text-headline-sm font-bold shadow-sm"><%= stage.num %></span>
              <span class="font-label-caps text-label-caps px-space-xs py-space-3xs <%= stage.badge ? 'bg-secondary text-on-secondary' : 'bg-primary-container text-secondary-fixed' %> rounded"><%= stage.duration %></span>
            </div>
            <h3 class="font-headline-sm text-headline-sm text-secondary-fixed mb-space-2xs"><%= stage.title %></h3>
            <p class="font-body-md text-body-md text-primary-fixed-dim mb-space-md leading-relaxed"><%= stage.desc %></p>
          </div>
          <div class="pt-space-sm bg-primary-container/40 rounded-lg p-space-xs">
            <span class="font-caption text-caption text-secondary-fixed block font-bold mb-space-3xs">Key Milestones:</span>
            <ul class="font-body-sm text-body-sm text-on-primary space-y-1">
              <% stage.milestones.forEach(m => { %>
                <li class="flex items-center gap-space-3xs"><span class="material-symbols-outlined text-[14px] text-secondary-fixed">check_circle</span> <%= m %></li>
              <% }) %>
            </ul>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
