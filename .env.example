# Local development only (`npm run dev`). Copy this to .dev.vars and fill in
# real values. On Cloudflare, set the same names under the Worker's
# Settings → Variables and Secrets instead — this file is never deployed.

# Get these from https://dashboard.paystack.com/#/settings/developer
# Start with the TEST keys (pk_test_... / sk_test_...) while building,
# then switch to LIVE keys (pk_live_... / sk_live_...) when you go live.
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email notification when a candidate pays & completes an application.
# RESEND_API_KEY comes from https://resend.com/api-keys — see README.
# ADMISSIONS_NOTIFY_EMAIL is who receives the notification (comma-separate
# several addresses). MAIL_FROM is optional until you verify your domain
# with Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
ADMISSIONS_NOTIFY_EMAIL=rootandriseinstitute@gmail.com
# MAIL_FROM=Root & Rise Admissions <admissions@yourdomain.com>
