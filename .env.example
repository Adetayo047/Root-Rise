# Get these from https://dashboard.paystack.com/#/settings/developer
# Start with the TEST keys (pk_test_... / sk_test_...) while building,
# then switch to LIVE keys (pk_live_... / sk_live_...) when you go live.
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email notification when a candidate pays & completes an application.
# SMTP_USER must be a Gmail address; SMTP_APP_PASSWORD is a 16-character
# "App Password" (NOT your normal Gmail password) — see README for how to
# generate one. ADMISSIONS_NOTIFY_EMAIL is who receives the notification;
# defaults to SMTP_USER if left blank.
SMTP_USER=rootandriseinstitute@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
ADMISSIONS_NOTIFY_EMAIL=rootandriseinstitute@gmail.com

PORT=3000
